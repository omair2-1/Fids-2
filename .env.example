# DATABASE_URL: Required. Postgres connection string for the real database.
# Get this from your provider (e.g. Supabase → Project Settings → Database →
# Connection string → URI, "Transaction" pooling mode for serverless hosts).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional key for OpenAI API chatbot interactions.
OPENAI_API_KEY=""

# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET: Required for real payments.
# Get these from your Razorpay Dashboard → Account & Settings → API Keys.
# Use rzp_test_ keys while testing; switch to live keys only once you're ready
# to accept real customer payments. The secret is shown only once when
# generated — if you lose it, regenerate a new key pair.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ADMIN_PASSKEY: Required in production. Login secret for the restaurant admin dashboard.
# If left unset, the server generates a temporary one and prints it to the server console
# on startup — fine for local testing, NOT fine for a live deployment. Set a real value here.
ADMIN_PASSKEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

